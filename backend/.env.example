# Copy to .env and fill in values. Never commit .env.
APP_NAME="IBM Bob Backend"
ENVIRONMENT=development
# JSON list of allowed origins for the Next.js frontend (add your deployed frontend URL)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Fireworks AI ───────────────────────────────────────────────────────────
# Server-side only. Never expose through NEXT_PUBLIC_* variables.
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_TIMEOUT_SECONDS=30.0
FIREWORKS_MAX_RETRIES=4

# Embedding model (Qwen3 Embedding 8B)
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_EMBEDDING_DIMENSIONS=356
FIREWORKS_EMBEDDING_BATCH_SIZE=32
FIREWORKS_EMBEDDING_MAX_CONCURRENCY=4

# Reranker model. Qwen3 Reranker 0.6B (fireworks/qwen3-reranker-0p6b) is dedicated-only on
# Fireworks and returns HTTP 500 without a deployment; the 8B reranker is serverless.
# For a dedicated deployment set FIREWORKS_RERANKER_MODEL to the deployed model id and,
# if needed, FIREWORKS_RERANKER_URL to its full rerank URL.
FIREWORKS_RERANKER_MODEL=fireworks/qwen3-reranker-8b
FIREWORKS_RERANKER_URL=
FIREWORKS_RERANKER_MAX_CANDIDATES=40

# LLM model (DeepSeek V4.1 Flash) — query expansion and HyDE
FIREWORKS_LLM_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_LLM_TIMEOUT_SECONDS=45.0
FIREWORKS_LLM_MAX_TOKENS=1024
FIREWORKS_LLM_TEMPERATURE=0.3

# ── Query preprocessing pipeline ──────────────────────────────────────────
QUERY_EXPANSION_COUNT=3
HYDE_ENABLED=true
FUSION_XGBOOST_WEIGHT=0.20
FUSION_RERANKER_WEIGHT=0.80
FUSION_RETRIEVAL_CANDIDATES=40
FUSION_MAX_ALTERNATIVES=2

# ── ChromaDB ───────────────────────────────────────────────────────────────
# DOCUMENTS_DIR, CHROMA_PERSIST_DIR and CHAT_DIR hold runtime data and are git-ignored.
# In production, point them at a persistent volume (they are lost on ephemeral hosts).
DOCUMENTS_DIR=data/documents
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=acme_onboarding_v2

# ── Upload limits ──────────────────────────────────────────────────────────
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_REQUEST_BYTES=209715200

# ── Semantic ingestion (DeepSeek via Fireworks) ────────────────────────────
# DeepSeek only describes structure and metadata; the HR-selected department is
# authoritative. If disabled or failing, ingestion falls back to structural sections.
INGESTION_LLM_ENABLED=true
INGESTION_LLM_MAX_TOKENS=8192
INGESTION_LLM_TEMPERATURE=0.0
INGESTION_LLM_REASONING_EFFORT=low
INGESTION_LLM_TIMEOUT_SECONDS=120
INGESTION_LLM_MAX_ATTEMPTS=3
INGESTION_LLM_MAX_CONCURRENCY=2
INGESTION_METADATA_MAX_CHARS=20000
INGESTION_SEGMENTATION_WINDOW_CHARS=24000
INGESTION_SEGMENTATION_MAX_WINDOWS=12
INGESTION_BLOCK_PREVIEW_CHARS=240

# ── Semantic chunks (approximate tokens) ───────────────────────────────────
SEMANTIC_CHUNK_MAX_TOKENS=450
SEMANTIC_CHUNK_OVERLAP_TOKENS=40

# ── Employee chat (POST /api/v1/chat/stream) ───────────────────────────────
# GLM 5.3 Flash writes the streamed Markdown answer (reasoning tokens are discarded).
FIREWORKS_ANSWER_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_ANSWER_MAX_TOKENS=2048
FIREWORKS_ANSWER_TEMPERATURE=0.2
FIREWORKS_ANSWER_TIMEOUT_SECONDS=60
FIREWORKS_ANSWER_REASONING_EFFORT=
# DeepSeek (FIREWORKS_LLM_MODEL) query expansion, HyDE and follow-up resolution
CHAT_PREPROCESS_MAX_TOKENS=2048
CHAT_PREPROCESS_REASONING_EFFORT=low
CHAT_PREPROCESS_TIMEOUT_SECONDS=30
CHAT_DIR=data/chats
CHAT_HISTORY_TURNS=4
CHAT_FOLLOWUP_MODE=auto
CHAT_MAX_CONCURRENT_STREAMS=8
CHAT_CONTEXT_TOKEN_BUDGET=6000
CHAT_DEPARTMENT_FILTER=routed
CHAT_LOW_CONFIDENCE_THRESHOLD=0.55
CHAT_MAX_FILTER_DEPARTMENTS=3

# ── Hybrid retrieval (semantic + BM25 -> RRF -> evidence filter -> MMR) ────
RETRIEVAL_SEMANTIC_K=30
RETRIEVAL_BM25_K=30
RETRIEVAL_FUSION_CANDIDATES=60
RETRIEVAL_TOP_K=20
RRF_K=60
RRF_WEIGHT_ORIGINAL=1.0
RRF_WEIGHT_EXPANSIONS=1.0
RRF_WEIGHT_HYDE=0.7
RRF_WEIGHT_BM25=1.0
RRF_WEIGHT_BM25_EXPANSIONS=0.3
MMR_LAMBDA=0.7
MMR_DUPLICATE_THRESHOLD=0.97
MMR_MAX_CHUNKS_PER_DOCUMENT=8
EVIDENCE_MIN_SIMILARITY=0.35
EVIDENCE_MIN_BM25=3.0
EVIDENCE_SUFFICIENT_SIMILARITY=0.45
EVIDENCE_SUFFICIENT_BM25=6.0
