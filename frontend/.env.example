# Copy to .env.local and adjust. Never commit .env.local.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are
# visible to every user. Only put public, non-secret values here — never the
# Fireworks API key or any other backend credential.

# Base URL of the FastAPI backend (no trailing slash).
# If unset: http://localhost:8000 in development, the Render backend
# (https://ibm-bob-2-0-hackathon.onrender.com) in production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
